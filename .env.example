DATABASE_URL=postgresql://username:password@localhost:5432/dbname
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
REDIS_URL=redis://127.0.0.1:6379
TAVILY_API_KEY=tvly-abcde12345

# LLM Providers Configuration
CHAT_LLM_PROVIDER=cliproxyapi
EMBEDDING_LLM_PROVIDER=cliproxyapi

# CLI Proxy API configuration
# FLASH y PRO son obligatorios: el proxy solo sirve los modelos que exponen sus
# propias credenciales, así que un nombre fijo en código falla con 502. Consulta
# los disponibles con: GET ${CLIPROXY_BASE_URL}/models
CLIPROXY_API_KEY=your_cliproxy_key
CLIPROXY_BASE_URL=https://api.tu-proxy.com/v1
CLIPROXY_FLASH_MODEL=gpt-4o-mini
CLIPROXY_PRO_MODEL=gpt-4o
# Opcionales. Sin definir, VISION reutiliza FLASH y THINKING reutiliza PRO.
CLIPROXY_VISION_MODEL=
CLIPROXY_THINKING_MODEL=

# OpenRouter configuration
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_FLASH_MODEL=openai/gpt-4o-mini
OPENROUTER_PRO_MODEL=openai/gpt-4o
# Opcionales. Sin definir, VISION reutiliza FLASH y THINKING reutiliza PRO.
OPENROUTER_VISION_MODEL=
OPENROUTER_THINKING_MODEL=

# Ollama (embeddings). cliproxyapi no expone /v1/embeddings, así que los
# embeddings salen por aquí. Ambas variables son obligatorias para este proveedor.
# Modelos disponibles: GET ${OLLAMA_BASE_URL%/v1}/api/tags
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_EMBEDDING_MODEL=bge-m3

# Whisper (transcripción de audio). Endpoint compatible con la API de OpenAI.
# No hay fallback simulado: sin esto configurado, el audio falla en vez de
# guardarse como un marcador que parece contenido.
WHISPER_BASE_URL=http://127.0.0.1:9000/v1
WHISPER_MODEL=large-v3
# WHISPER_API_KEY=  # opcional: solo si tu endpoint exige autenticación

# Codex / Antigravity keys
CODEX_API_KEY=your_codex_key
ANTIGRAVITY_API_KEY=your_antigravity_key


